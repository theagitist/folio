#!/bin/sh
# Render a PDF into numbered WebP pages (1.webp, 2.webp, ...) for folio.
# Needs pdftoppm and pdfinfo (poppler-utils) and cwebp (webp).
set -eu

if [ $# -lt 2 ]; then
  echo "usage: folio-render <file.pdf> <outdir> [dpi=150] [quality=80]" >&2
  exit 1
fi

pdf=$1 out=$2 dpi=${3:-150} q=${4:-80}
mkdir -p "$out"
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

pdftoppm -r "$dpi" -png "$pdf" "$tmp/p"

n=0
for f in "$tmp"/p-*.png; do # pdftoppm zero-pads, so the glob sorts in page order
  n=$((n + 1))
  cwebp -quiet -q "$q" "$f" -o "$out/$n.webp"
done

ratio=$(pdfinfo "$pdf" 2>/dev/null | awk '/^Page size:/ { print $3 " / " $5; exit }')
echo "$n pages written to $out"
echo "<div class=\"folio\" data-src=\"$out/{n}.webp\" data-count=\"$n\" style=\"--folio-ratio: $ratio\"></div>"
